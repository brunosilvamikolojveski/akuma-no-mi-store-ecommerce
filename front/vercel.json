{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mangaverse-ecommerce-production.up.railway.app/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://mangaverse-ecommerce-production.up.railway.app/sanctum/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://mangaverse-ecommerce-production.up.railway.app/storage/:path*"
    },
    {
      "source": "/up",
      "destination": "https://mangaverse-ecommerce-production.up.railway.app/up"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
